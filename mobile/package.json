{
  "name": "reloved-android",
  "version": "1.0.0",
  "private": true,
  "description": "Android app shell for Reloved (Capacitor)",
  "scripts": {
    "icons": "node scripts/make-icons.mjs",
    "android:add": "node scripts/build-www.mjs && cap add android && node scripts/patch-android.mjs",
    "android:sync": "node scripts/build-www.mjs && cap sync android",
    "www": "node scripts/build-www.mjs"
  },
  "dependencies": {
    "@capacitor/android": "8.5.3",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/preferences": "8.0.1",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4",
    "@capgo/capacitor-social-login": "8.7.5"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@capacitor/assets": "3.0.5"
  }
}
