# Copy to .env for local development. Never commit .env. In production set these in the host's secret settings.
NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://postgres:postgres@localhost:5432/reloved
# off (local only) | require | verify-full
DATABASE_SSL=off
# DATABASE_CA_CERT="-----BEGIN CERTIFICATE-----..."
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=30
SESSION_MAX_DAYS=90
PASSWORD_RESET_TTL_MINUTES=30
# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=http://localhost:5173,http://localhost:3000
# false only for local http development
COOKIE_SECURE=false
# Number of reverse proxies in front of the API (Render/Railway/Fly: usually 1)
TRUST_PROXY_HOPS=0
# 32 random bytes, base64. Encrypts PAN and bank account numbers. Back it up separately; losing it makes them unreadable.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
DATA_ENCRYPTION_KEY=
# local (development) | supabase (required in production; create a PRIVATE bucket first)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./.storage
# SUPABASE_URL=https://pcvhiqamniurynfdznwt.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=   (server only, never in the PWA or the repo)
STORAGE_BUCKET=seller-kyc
LOG_LEVEL=info
# MOCK / TEMPORARY: returns password-reset tokens in the API response (no email provider yet). Refused in production.
DEV_EXPOSE_RESET_TOKEN=true
