{
  "functions": {
    "api/page.js": { "includeFiles": "index.html" }
  },
  "redirects": [
    { "source": "/server/:path*", "destination": "/", "permanent": false }
  ],
  "rewrites": [
    { "source": "/item/:id/:slug?", "destination": "/api/page?kind=item&id=:id" },
    { "source": "/c/:path*", "destination": "/api/page?kind=c&path=:path*" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/api/:path((?!page$|sitemap$).*)", "destination": "https://reloved-pwa-xumb.vercel.app/api/:path" },
    { "source": "/:first(search|seller|home|discover|sell|inbox|cart|profile)/:rest*", "destination": "/index.html" },
    { "source": "/:first(search|seller|home|discover|sell|inbox|cart|profile)", "destination": "/index.html" }
  ]
}
